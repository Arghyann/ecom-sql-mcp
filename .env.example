# Copy to .env (optional). All values below are the defaults.

# Only needed if the dataset ever becomes private/gated. Use a READ-ONLY token.
# HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxx

# HF_DATASET_REPO=HariJha/FreeEcommerceTwin14M
# HF_DATASET_REVISION=main        # or a commit sha, e.g. 84b6d69e3fc3b52565886a04bcfcb482cf97a232

# QUERY_MAX_ROWS=100
# QUERY_TIMEOUT_SECONDS=120
# DUCKDB_MEMORY_LIMIT=2GB
# DUCKDB_THREADS=4
# HTTP_TIMEOUT_SECONDS=30
# HTTP_RETRIES=3

# Local mode (fast): run `python download_data.py` once, then:
# LOCAL_DATA_DIR=./data_cache
